PORT=3000
DB_PATH=./backend/db.sqlite

# Optional: Twilio SMS Configuration
# Get your credentials from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Optional: Email Configuration (using Nodemailer)
# For Gmail: use https://myaccount.google.com/apppasswords (App Password, not regular password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=your-email@gmail.com

# For other providers (SendGrid, Mailgun, etc.), update SMTP_HOST and port accordingly
